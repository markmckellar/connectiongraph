{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "useDefineForClassFields": false,
    "jsx": "preserve",
    "types": ["vite/client"],
    "noEmit": true
  },
  "include": ["source/**/*.ts", "src/**/*.ts", "src/**/*.vue"]
}
